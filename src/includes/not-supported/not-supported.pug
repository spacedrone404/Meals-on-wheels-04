style. 

    .not-supported-message {
        display: none;
    }

    @media (width < 1278px) {
    .top-bar,
    .menu-editor-wrapper,
    .templates-wrapper,
    .bottompanel-section,
    .basebase-wrapper,
    .container,
    .row,
    .vid-wrapper,
    #scrollTop,
    #side-panel {
        filter: blur(8px);
    } 


    * {
        pointer-events: none;
    }
    
    html {
        background: black;
        color: white;
        overflow: hidden;
    }

    .not-supported-message {
        display: flex;
        box-shadow: 0 0 15px rgba(225, 68, 11, 0.8) inset, 0 0 10px rgba(234, 77, 29, 0.2), 0 0 15px rgba(220, 51, 13, 0.1), 0 0 15px rgb(225, 68, 11), 0 0 10px rgba(234, 77, 29, 0.2), 0 0 15px rgba(220, 51, 13, 0.1);                
        font-size: 40px;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: red;
        border: 4px solid red;
        position: fixed;
        padding: 5px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); 
        width: fit-content;
        height: 25vh;
        z-index: 18000000;
        pointer-events: auto;
        text-shadow: 1.4px -0.6px 0 #ffffff, 1.6px 1.4px 0 #ffffff, 2.4px 1.6px 0 #ffffff, 1.6px 0.6px 0 #ffffff;
        }
    }

    @media (width < 480px) {
        .not-supported-message{
            font-size: 30px;
            padding: 10px;
            top: 40%;
    }
}

.not-supported-message Resolutions less than 1278px are not supported

script. 
    document.body.classList.add("no-scroll");